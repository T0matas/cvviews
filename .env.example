# Groq (free tier): get a key at https://console.groq.com
GROQ_API_KEY=gsk_...
# Optional: Groq model (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Or xAI Grok, used when GROQ_API_KEY is not set: https://console.x.ai
# XAI_API_KEY=xai-...
# XAI_MODEL=grok-4

# --- Plans (see PAGAMENTOS.md) ---
# Stripe, for the Pro subscription. Without these, nobody is charged and "Passar a Pro" says payments are off.
# STRIPE_SECRET_KEY=sk_test_...      (secret: only in .env and in Vercel, never in the code)
# STRIPE_PRICE_ID=price_...          (the 4,99 € monthly price)
# Firebase service account (JSON on one line), so the server can count the free plan's uses.
# Without it, nothing is counted and the free plan has no limits.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# The site's address, for the links back from Stripe (on Vercel, e.g. https://cvviews.pt)
# SITE_URL=https://cvviews.pt
