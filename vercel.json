{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [
    { "source": "/como-funciona", "destination": "/#como-funciona", "permanent": false },
    { "source": "/entrevistas", "destination": "/#entrevistas", "permanent": false },
    { "source": "/perguntas", "destination": "/#perguntas", "permanent": false },
    { "source": "/privacy", "destination": "/privacidade", "permanent": true },
    { "source": "/terms", "destination": "/termos", "permanent": true },
    { "source": "/login", "destination": "/entrar", "permanent": true }
  ]
}
